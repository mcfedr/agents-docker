<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.mcfedr.agents-chrome</string>

	<!-- __WORKDIR__ is substituted with the repo path by `make chrome-start`. -->
	<key>ProgramArguments</key>
	<array>
		<string>__WORKDIR__/agents-chrome</string>
		<string>serve</string>
	</array>

	<!-- Neither RunAtLoad nor KeepAlive: the socket job kickstarts this on the
	     first connection, and it exits by itself once idle. Because this plist
	     is NOT in ~/Library/LaunchAgents it does not survive logout/reboot. -->

	<key>StandardOutPath</key>
	<string>/tmp/agents-chrome.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/agents-chrome.log</string>
</dict>
</plist>
