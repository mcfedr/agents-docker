#!/bin/sh
# Attach chrome-devtools-mcp to a Chrome running on the *host* machine (started
# by `make chrome` with --remote-debugging-port=9333 on the host's 127.0.0.1).
#
# Two problems this wrapper solves:
#   1. Inside the container, 127.0.0.1 is the container itself, not the host.
#      The host's Chrome is reachable at host.docker.internal:9333 (the same
#      route the Ollama config uses).
#   2. Chrome's DevTools HTTP endpoint rejects any request whose Host header is
#      not "localhost" or a bare IP address (DNS-rebinding protection), so
#      pointing --browser-url straight at host.docker.internal:9333 returns 403.
#
# Fix: run a socat listener on 127.0.0.1:9333 *inside* the container that
# forwards to the host. chrome-devtools-mcp then connects to 127.0.0.1 (an
# accepted Host) and socat relays the raw bytes to the host's Chrome. This is
# the container equivalent of the SSH tunnel in the official troubleshooting
# docs: `ssh -N -L 127.0.0.1:9333:127.0.0.1:9333 user@host`.
#
# Each agent runs its own copy of this wrapper as a plain stdio MCP server. That
# is deliberate: stdio servers have no per-request timeout and a 30-minute idle
# window, where an HTTP gateway would impose a 60-second first-byte deadline
# (fatal for lighthouse_audit and trace recording) and a 5-minute idle window.
# Because nothing here *launches* Chrome, concurrent agents do not contend for
# the profile lock either -- they are just several CDP clients on one browser.
set -e

HOST_ENDPOINT="${CHROME_HOST_ENDPOINT:-host.docker.internal:9333}"
LOCAL_PORT="${CHROME_LOCAL_PORT:-9333}"

# Start the loopback bridge once. The probe connects through any existing
# listener (harmless) and only spawns a new socat when nothing answers, so
# repeated MCP restarts don't pile up duplicate forwarders.
#
# CDP connections are long-lived WebSockets that sit idle while the agent
# thinks, and Docker Desktop's NAT drops idle flows; the keepalive options make
# the kernel poke the connection often enough to keep the mapping alive.
if ! socat -T1 STDIN "TCP:127.0.0.1:${LOCAL_PORT}" </dev/null >/dev/null 2>&1; then
    socat "TCP-LISTEN:${LOCAL_PORT},fork,reuseaddr,bind=127.0.0.1" \
        "TCP:${HOST_ENDPOINT},keepalive,keepidle=30,keepintvl=10,keepcnt=3" \
        >/dev/null 2>&1 &
fi

exec chrome-devtools-mcp --browser-url "http://127.0.0.1:${LOCAL_PORT}" "$@"
